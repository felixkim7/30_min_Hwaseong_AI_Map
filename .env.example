# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real keys.
#
# RULE: Only variables that are safe to expose in the browser may use the
# NEXT_PUBLIC_ prefix. Every secret below has NO prefix and is used only in
# server-side code (Route Handlers under app/api/). The contest forbids leaking
# API keys, so treat this seriously.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# URL and anon key are safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key bypasses RLS. SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# LLM provider (pick ONE and set it in ARCHITECTURE.md too)
# Used only inside app/api/ route handlers. SERVER ONLY.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai            # openai | anthropic | gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Public data (phase 08) — Gyeonggi / data.go.kr open APIs. SERVER ONLY.
# Register at https://data.gg.go.kr or https://www.data.go.kr to get a key.
# ---------------------------------------------------------------------------
GYEONGGI_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Admin dashboard (phase 06) — shared passphrase gate. SERVER ONLY.
# Simple by design (see CLAUDE.md rule: keep auth minimal). Pick any string.
# ---------------------------------------------------------------------------
ADMIN_PASSPHRASE=

# ---------------------------------------------------------------------------
# Map — Leaflet + OpenStreetMap needs no key by default.
# If you switch to Kakao Map, its JS key IS exposed to the browser (that is how
# Kakao works), so restrict it by domain in the Kakao console.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_KAKAO_MAP_KEY=

# ---------------------------------------------------------------------------
# Kakao Local API — keyword search geocoding. SERVER ONLY.
# Used to resolve a citizen's free-text location into real coordinates
# (replaces the static landmark table in lib/geocode.ts). Register at
# https://developers.kakao.com — use the REST API key, not the Admin key.
# ---------------------------------------------------------------------------
KAKAO_REST_API_KEY=

# ---------------------------------------------------------------------------
# Naver Cloud Platform — Geocoding / Reverse Geocoding. SERVER ONLY.
# NOTE: forward Geocoding was returning zero results for all queries as of
# 2026-07-12 (new Maps product, ~2.5 weeks old) — switched to Kakao for that.
# Reverse Geocoding (coords -> address) was confirmed working, kept here in
# case it's useful later. Register at https://www.ncloud.com.
# ---------------------------------------------------------------------------
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
